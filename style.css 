* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f5f3ef;
  color: #191817;
  font: 16px system-ui, sans-serif;
  line-height: 1.55;
}

.site-header,
main {
  width: min(1000px, calc(100% - 32px));
  margin: auto;
}

.site-header {
  padding: 28px 0 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.brand {
  display: flex;
  align-items: center;
  gap: 18px;
}

.brand svg {
  width: 170px;
  height: auto;
}

.brand h1 {
  margin: 4px 0;
  font-size: 30px;
}

.brand p,
.brand small {
  color: #6b675f;
}

.header-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

main {
  padding-bottom: 48px;
}

.card {
  background: #fff;
  border: 1px solid #d7d2c9;
  border-radius: 18px;
  padding: 24px;
  margin: 16px 0;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .05);
}

h2 {
  margin-top: 0;
}

label {
  display: grid;
  gap: 6px;
  margin: 14px 0;
  font-weight: 600;
}

input,
textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #bbb6ad;
  border-radius: 10px;
  background: #faf9f6;
  color: inherit;
  font: inherit;
}

textarea {
  min-height: 120px;
  resize: vertical;
}

button {
  min-height: 44px;
  padding: 10px 16px;
  border: 1px solid #bbb6ad;
  border-radius: 22px;
  background: #111;
  color: #fff;
  font-weight: 700;
  cursor: pointer;
}

button:hover {
  opacity: .85;
}

button + button {
  background: transparent;
  color: inherit;
}

.comments-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.comment {
  border: 1px solid #d7d2c9;
  border-radius: 12px;
  padding: 16px;
  margin: 12px 0;
}

.comment-meta {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  color: #6b675f;
}

.comment-name {
  color: #191817;
  font-weight: 700;
}

.comment-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-wrap: wrap;
}

.comment-actions button {
  font-size: 14px;
}

#message {
  min-height: 24px;
  color: #28643b;
}

body.dark {
  background: #151515;
  color: #eee;
}

body.dark .card,
body.dark .comment {
  background: #222;
  border-color: #444;
}

body.dark input,
body.dark textarea {
  background: #181818;
  color: #eee;
  border-color: #555;
}

body.dark .brand p,
body.dark .brand small,
body.dark .comment-meta {
  color: #bbb;
}

body.dark .comment-name {
  color: #fff;
}

@media (max-width: 650px) {
  .brand {
    align-items: flex-start;
  }

  .brand svg {
    width: 120px;
  }

  .brand h1 {
    font-size: 24px;
  }
}

