const CONFIG = {
  GITHUB_TOKEN: "PASTE_YOUR_GITHUB_TOKEN_HERE",
  GIST_ID: "PASTE_YOUR_GIST_ID_HERE",
  GIST_FILENAME: "comments.json",
  ADMIN_PASSWORD: "admin$123#"
};

let comments = [];
let isAdmin = false;

const form = document.querySelector("#commentForm");
const list = document.querySelector("#commentsList");
const message = document.querySelector("#message");
const loginButton = document.querySelector("#loginButton");
const logoutButton = document.querySelector("#logoutButton");
const refreshButton = document.querySelector("#refreshButton");
const themeButton = document.querySelector("#themeButton");

function escapeHtml(value = "") {
  const element = document.createElement("div");
  element.textContent = value;
  return element.innerHTML;
}

function isConfigured() {
  return (
    !CONFIG.GITHUB_TOKEN.includes("PASTE_") &&
    !CONFIG.GIST_ID.includes("PASTE_")
  );
}

async function gistRequest(method = "GET", body = undefined) {
  const response = await fetch(
    `https://api.github.com/gists/${CONFIG.GIST_ID}`,
    {
      method,
      headers: {
        Accept: "application/vnd.github+json",
        Authorization: `Bearer ${CONFIG.GITHUB_TOKEN}`,
        "X-GitHub-Api-Version": "2022-11-28"
      },
      body: body ? JSON.stringify(body) : undefined
    }
  );

  if (!response.ok) {
    throw new Error(`GitHub API error: ${response.status}`);
  }

  return response.json();
}

async function loadComments() {
  if (!isConfigured()) {
    list.innerHTML =
      "<p>Configurează tokenul și Gist ID-ul în app.js.</p>";
    return;
  }

  try {
    const gist = await gistRequest();
    const file = gist.files?.[CONFIG.GIST_FILENAME];

    comments = file?.content
      ? JSON.parse(file.content)
      : [];

    renderComments();
  } catch (error) {
    list.innerHTML =
      "<p>Nu am putut încărca comentariile din Gist.</p>";
  }
}

async function saveComments() {
  await gistRequest("PATCH", {
    files: {
      [CONFIG.GIST_FILENAME]: {
        content: JSON.stringify(comments, null, 2)
      }
    }
  });
}

function renderComments() {
  if (!comments.length) {
    list.innerHTML = "<p>Nu există comentarii încă.</p>";
    return;
  }

  list.innerHTML = comments.map((item) => `
    <article class="comment">
      <div class="comment-meta">
        <span class="comment-name">${escapeHtml(item.name)}</span>
        <span>${new Date(item.timestamp).toLocaleString("ro-RO")}</span>
      </div>

      <strong>${escapeHtml(item.subject)}</strong>
      <p>${escapeHtml(item.comment)}</p>

      <div class="comment-actions">
        <button type="button"
                onclick="editComment('${item.id}')">
          Editează
        </button>

        ${
          isAdmin
            ? `<button type="button"
                       onclick="deleteComment('${item.id}')">
                 Șterge
               </button>`
            : ""
        }
      </div>
    </article>
  `).join("");
}

form.addEventListener("submit", async (event) => {
  event.preventDefault();

  if (!isConfigured()) {
    message.textContent =
      "Configurează GITHUB_TOKEN și GIST_ID în app.js.";
    return;
  }

  const data = new FormData(form);

  const item = {
    id: crypto.randomUUID(),
    name: data.get("name").trim(),
    email: data.get("email").trim(),
    subject: data.get("subject").trim(),
    comment: data.get("comment").trim(),
    timestamp: new Date().toISOString()
  };

  if (!item.name || !item.subject || !item.comment) {
    message.textContent =
      "Nume, subiect și comentariu sunt obligatorii.";
    return;
  }

  comments.unshift(item);

  try {
    await saveComments();
    form.reset();
    message.textContent = "Comentariul a fost salvat.";
    renderComments();
  } catch (error) {
    comments = comments.filter((entry) => entry.id !== item.id);
    message.textContent =
      "Comentariul nu a putut fi salvat.";
  }
});

window.editComment = async function (id) {
  const item = comments.find((entry) => entry.id === id);

  if (!item) {
    return;
  }

  const updated = prompt("Comentariu:", item.comment);

  if (updated === null) {
    return;
  }

  item.comment = updated.trim();
  item.timestamp = new Date().toISOString();

  try {
    await saveComments();
    renderComments();
  } catch (error) {
    alert("Editarea nu a putut fi salvată.");
  }
};

window.deleteComment = async function (id) {
  if (!isAdmin) {
    return;
  }

  if (!confirm("Sigur vrei să ștergi comentariul?")) {
    return;
  }

  const previous = [...comments];

  comments = comments.filter((entry) => entry.id !== id);

  try {
    await saveComments();
    renderComments();
  } catch (error) {
    comments = previous;
    alert("Ștergerea nu a putut fi salvată.");
  }
};

loginButton.addEventListener("click", () => {
  const password = prompt("Parola admin:");

  if (password === CONFIG.ADMIN_PASSWORD) {
    isAdmin = true;
    loginButton.textContent = "Admin activ";
    logoutButton.hidden = false;
    renderComments();
  } else if (password !== null) {
    alert("Parolă greșită.");
  }
});

logoutButton.addEventListener("click", () => {
  isAdmin = false;
  loginButton.textContent = "Login admin";
  logoutButton.hidden = true;
  renderComments();
});

refreshButton.addEventListener("click", loadComments);

themeButton.addEventListener("click", () => {
  document.body.classList.toggle("dark");
});

loadComments();

